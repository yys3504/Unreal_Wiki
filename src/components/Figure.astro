---
// 캡션이 달린 이미지(스크린샷) 카드. 클릭하면 전체 화면 라이트박스로 확대해서 볼 수 있다.
// 사용: <Figure src="/images/ch1/ch1-3-transform.png" alt="Transform 화면" caption="Details 탭의 Transform" />
interface Props {
  /** public/ 기준 절대 경로 (예: /images/ch1/foo.png) */
  src: string;
  /** 대체 텍스트 (한국어로, 필수) */
  alt: string;
  /** 이미지 아래 캡션 (선택) */
  caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<figure class="ue-figure">
  <button type="button" class="ue-figure__zoom" aria-label={`이미지 확대: ${alt}`}>
    <img src={src} alt={alt} loading="lazy" />
    <span class="ue-figure__hint" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
    </span>
  </button>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .ue-figure {
    margin: 1rem 0 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 10px;
    background: var(--sl-color-gray-6);
    padding: 10px;
  }
  /* 이미지를 감싼 확대 버튼 — 버튼 기본 스타일을 모두 리셋한다 */
  .ue-figure__zoom {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    border-radius: 8px;
    cursor: zoom-in;
    position: relative;
    overflow: hidden;
    line-height: 0;
  }
  .ue-figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }
  /* 확대 가능함을 알리는 호버 힌트 배지 */
  .ue-figure__hint {
    position: absolute;
    right: 8px;
    bottom: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    opacity: 0;
    transition: opacity 0.15s ease;
    pointer-events: none;
  }
  .ue-figure__zoom:hover .ue-figure__hint,
  .ue-figure__zoom:focus-visible .ue-figure__hint {
    opacity: 1;
  }
  .ue-figure__zoom:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .ue-figure figcaption {
    margin-top: 0.5rem;
    font-size: 0.86rem;
    color: var(--sl-color-gray-3);
    text-align: center;
  }
</style>

<style is:global>
  /* 클릭 시 뜨는 전체 화면 라이트박스 (body에 1개만 생성되어 모든 Figure가 공유) */
  .ue-lightbox[hidden] {
    display: none;
  }
  .ue-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4vmin;
    background: rgba(0, 0, 0, 0.85);
    opacity: 0;
    transition: opacity 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .ue-lightbox.is-open {
    opacity: 1;
  }
  /* 원본 크기 모드 — 뷰포트보다 커지면 스크롤로 패닝 */
  .ue-lightbox.is-actual {
    overflow: auto;
    align-items: flex-start;
  }
  .ue-lightbox__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
  }
  .ue-lightbox__img {
    display: block;
    max-width: 92vw;
    max-height: 86vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.5);
    cursor: zoom-in;
    transform: scale(0.96);
    transition: transform 0.2s ease;
  }
  .ue-lightbox.is-open .ue-lightbox__img {
    transform: scale(1);
  }
  .ue-lightbox__img.is-actual {
    max-width: none;
    max-height: none;
    cursor: zoom-out;
  }
  .ue-lightbox__cap {
    margin: 0;
    color: #e6e6e6;
    font-size: 0.9rem;
    line-height: 1.6;
    text-align: center;
    max-width: 70ch;
  }
  .ue-lightbox__cap[hidden] {
    display: none;
  }
  .ue-lightbox__close {
    position: fixed;
    top: 0.85rem;
    right: 1rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-size: 1.7rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .ue-lightbox__close:hover {
    background: rgba(255, 255, 255, 0.28);
  }
  @media (prefers-reduced-motion: reduce) {
    .ue-lightbox,
    .ue-lightbox__img {
      transition: none;
    }
  }
</style>
